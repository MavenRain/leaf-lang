-- The keystore core names (S5 U2, Q-S5-4 (a), Q-S5-5 (b), Q-S5-15 (a)).
-- skSeed and pubSeed are the seeds of root4 in test/eval/xmss.lang. A
-- Leaf comes only out of next: each row opens the Durable with opened (a
-- fold), the Option with option and the pair with unpack.
skSeed : Digest
skSeed = digest 9 10 11 12

skPrf : Digest
skPrf = digest 5 6 7 8

pubSeed : Digest
pubSeed = digest 1 2 3 4

msg : Digest
msg = digest 13 14 15 16

ks4 : Keystore
ks4 = keygen skSeed skPrf pubSeed (v1Params 4)

ks3 : Keystore
ks3 = keygen skSeed skPrf pubSeed (v1Params 3)

ks0 : Keystore
ks0 = keygen skSeed skPrf pubSeed (v1Params 0)

-- The Option that a next tree holds. The fold needs this declared type.
opened : Durable (Option (Leaf × Keystore)) ⊸ Option (Leaf × Keystore)
opened d = fold (λ o → o) (λ n r → r) d

-- The public key of ks4. unpack drops the keystore half.
pk4 : PubKey
pk4 = unpack (publicKey ks4) (λ pk ks → pk)

-- ks4 after one next.
afterOne : Keystore
afterOne = option ks4 (λ p → unpack p (λ l ks → ks)) (opened (next ks4))

-- The height of the first leaf of ks4.
height4 : ℕ
height4 = option 99 (λ p → unpack p (λ l ks → leafHeight l)) (opened (next ks4))

-- The index in the signature of the first leaf and of the second leaf.
signIndex : ℕ
signIndex = option 99 (λ p → unpack p (λ l ks → witness (sign l msg))) (opened (next ks4))

signIndex1 : ℕ
signIndex1 = option 99 (λ p → unpack p (λ l ks → witness (sign l msg))) (opened (next afterOne))

-- A signature with its height. sign takes the leaf at 1, and verifyAt
-- takes its Sig at omega, so the pair leaves the scope of the leaf as a
-- top-level value. A none gives a dummy at h = 0, which does not verify.
sig4 : (h : ℕ) × Sig h
sig4 = option (pack 0 (pack 0 (pack msg (pack (λ k → msg) (λ k → msg))))) (λ p → unpack p (λ l ks → pack (leafHeight l) (sign l msg))) (opened (next ks4))

sig3 : (h : ℕ) × Sig h
sig3 = option (pack 0 (pack 0 (pack msg (pack (λ k → msg) (λ k → msg))))) (λ p → unpack p (λ l ks → pack (leafHeight l) (sign l msg))) (opened (next ks3))

height3 : ℕ
height3 = witness sig3

-- The first leaf of ks4 signs msg, and verifyAt accepts the signature
-- under pk4.
verifyOk : Bool
verifyOk = verifyAt (witness sig4) pk4 msg (payload sig4)

-- A Sig 3 of the h = 3 key does not verify under pk4.
verifyBad : Bool
verifyBad = verifyAt (witness sig3) pk4 msg (payload sig3)

-- h = 0 (Q-S5-15 (a)): next at 0 commits 1 and gives the only leaf; next
-- at 1 gives done none.
next0 : Durable (Option (Leaf × Keystore))
next0 = next ks0

ks0At1 : Keystore
ks0At1 = option ks0 (λ p → unpack p (λ l ks → ks)) (opened (next ks0))

next1 : Durable (Option (Leaf × Keystore))
next1 = next ks0At1
