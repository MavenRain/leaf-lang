-- L1 at h = 4 (S4 U6, Q-S4-7 (a)): for each leaf i of pk4 and a message m,
-- verify pk4 m (signAt sk skPrf pk4 i m) is true. In S5, L1 is on the
-- keystore (next and sign).
s : Digest
s = digest 1 2 3 4

sk : Digest
sk = digest 9 10 11 12

skPrf : Digest
skPrf = digest 13 14 15 16

msg : Digest
msg = digest 1311768467463790320 0 0 15

pk4 : PubKey
pk4 = pkFromSeeds sk s (v1Params 4)

-- l1At pk m i is true when the signature of m at leaf i verifies.
l1At : (pk : PubKey) → (m : Digest) → (i : ℕ) → Bool
l1At pk m i = verify pk m (signAt sk skPrf pk i m)

-- The fold state of l1All: the leaf index and the and of the results.
lawState : (i : ℕ) → (b : Bool) → ℕ × Bool
lawState i b = pack i b

-- l1All pk m is true when l1At pk m i is true for i = 0 to 15 (the 16
-- leaves at h = 4).
l1All : (pk : PubKey) → (m : Digest) → Bool
l1All pk m = payload (fold (λ (st : ℕ × Bool) → lawState (natAdd (witness st) 1) (boolElim (λ b → Bool) (l1At pk m (witness st)) false (payload st))) (lawState 0 true) 16)

l1Msg : Bool
l1Msg = l1All pk4 msg

-- Single leaves with other messages.
l1Zero : Bool
l1Zero = l1At pk4 (digest 0 0 0 0) 0

l1Last : Bool
l1Last = l1At pk4 (digest 1311768467463790320 0 0 14) 15

l1Mid : Bool
l1Mid = l1At pk4 (digest 5 6 7 8) 10

-- L2 at h = 4 (S6 U3, D5): accept pk4 k m s is true only when the index of
-- s is k. l2Ok i is the signature of msg at leaf i, at the nonce i.
l2Ok : (i : ℕ) → Bool
l2Ok i = accept pk4 i msg (signAt sk skPrf pk4 i msg)

-- l2Next i is the same signature at the nonce i + 1.
l2Next : (i : ℕ) → Bool
l2Next i = accept pk4 (natAdd i 1) msg (signAt sk skPrf pk4 i msg)

-- l2BadM is the signature of msg at leaf 7, at the nonce 7, over another
-- message: the nonce compare passes and verify gives false.
l2BadM : Bool
l2BadM = accept pk4 7 (digest 5 6 7 8) (signAt sk skPrf pk4 7 msg)

-- L7 vectors at h = 4 (S7 U4, D6): the entry at position k has the key
-- l7Key k, the message l7Msg k and the signature of leaf k. At the
-- position bad, the signature is of an other message, so verify gives
-- false there. l7 n bad is aggregate on the first n entries; bad = n
-- gives n valid entries.
l7Seed : (k : ℕ) → Digest
l7Seed k = digest 9 10 11 k

l7Key : (k : ℕ) → PubKey
l7Key k = pkFromSeeds (l7Seed k) s (v1Params 4)

l7Msg : (k : ℕ) → Digest
l7Msg k = digest k 1 2 3

l7Entry : (bad : ℕ) → (k : ℕ) → Signer
l7Entry bad k = pack (l7Key k) (pack (l7Msg k) (signAt (l7Seed k) skPrf (l7Key k) k (boolElim (λ b → Digest) (l7Msg 99) (l7Msg k) (natEq k bad))))

l7Vec : (n : ℕ) → (bad : ℕ) → (i : Fin n) → Signer
l7Vec n bad i = l7Entry bad (witness i)

l7 : (n : ℕ) → (bad : ℕ) → Bool
l7 n bad = aggregate n (l7Vec n bad)
