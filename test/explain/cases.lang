-- The explain cases (S9 D10, D11; test/explain/expect.txt).
-- A pure function: one omega binder, no leaves, no laws.
double : (n : ℕ) → ℕ
double n = natAdd n n

-- A fold over the domain data type Color (data CM): the arms of a match.
colorCode : (c : Color) → ℕ
colorCode c = fold 1 2 3 c

-- An affine leaf use: next gives the leaf, sign takes it one time.
opened : Durable (Option (Leaf × Keystore)) ⊸ Option (Leaf × Keystore)
opened d = fold (λ o → o) (λ n r → r) d

signOnce : Keystore ⊸ ℕ
signOnce ks = option 0 (λ p → unpack p (λ l kr → witness (sign l (digest 1 2 3 4)))) (opened (next ks))
