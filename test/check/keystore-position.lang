-- R5 (S5 U2): a keystore value holds its position, so two keystore
-- values of one key at different positions do not convert. In check,
-- next on ks0 gives the keystore at 1, and refl does not prove that it
-- is ks0 at 0.
opened : Durable (Option (Leaf × Keystore)) ⊸ Option (Leaf × Keystore)
opened d = fold (λ o → o) (λ n r → r) d

ks0 : Keystore
ks0 = keygen (digest 9 10 11 12) (digest 5 6 7 8) (digest 1 2 3 4) (v1Params 0)

p : Path Keystore ks0 (option ks0 (λ q → unpack q (λ l ks → ks)) (opened (next ks0)))
p = refl
