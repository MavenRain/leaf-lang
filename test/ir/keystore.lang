-- A key from closed seeds lowers by eval (S5 U4d, Q-S5-24). Each hash op
-- stays a hash node: keygen at v1Params 0 gives 1138 hash statements, and
-- the rand field of the signature gives one more. The IR is too large for
-- an .ir file, so test/gate.sh checks its sha-256 (test/ir/keystore.sha256).
opened : Durable (Option (Leaf × Keystore)) ⊸ Option (Leaf × Keystore)
opened d = fold (λ o → o) (λ n r → r) d

keyRow : (n : ℕ) → Bool
keyRow n = unpack (publicKey (keygen (digest n 2 3 4) (digest 5 6 7 8) (digest 1 2 3 4) (v1Params 0))) (λ pk ks → option false (λ p → unpack p (λ l k → digestEq (witness pk) (witness (payload (sign l (digest (leafHeight l) n 0 0)))))) (opened (next ks)))

-- wotsRow (S5 U4e) sequences next with andThen and reads one wots field of
-- the signature at the closed Fin 65 (a checksum digit). The message hash
-- stays a hash node, so the digit and the chain length are neutral.
settled : Durable Bool ⊸ Bool
settled d = fold (λ b → b) (λ n r → r) d

wotsRow : (n : ℕ) → Bool
wotsRow n = unpack (publicKey (keygen (digest n 2 3 4) (digest 5 6 7 8) (digest 1 2 3 4) (v1Params 0))) (λ pk ks → settled (andThen (next ks) (λ o → done Bool (option false (λ p → unpack p (λ l k → digestEq (witness pk) (witness (payload (payload (sign l (digest (leafHeight l) n 0 0)))) (pack 65 refl)))) o))))
