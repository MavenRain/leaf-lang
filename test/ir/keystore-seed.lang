-- A keygen over a seed that is a prf output (a hash that stays stuck in
-- `langc ir`) is refused. Runtime keys come with the signer (S5 U6).
seedRow : (n : ℕ) → Bool
seedRow n = unpack (publicKey (keygen (prf (digest n 2 3 4) (randTweak 0)) (digest 5 6 7 8) (digest 1 2 3 4) (v1Params 0))) (λ pk ks → digestEq (witness pk) (digest 0 0 0 0))
