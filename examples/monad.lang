-- Former F5: pure, map and bind over Option. A Sum uses fold.
lifted : Option ℕ
lifted = map (λ (n : ℕ) → natAdd n 1) (some 4)

chained : Option ℕ
chained = bind (some 4) (λ (n : ℕ) → some (natMul n 2))

wrapped : Option ℕ
wrapped = pure 5

three : Sum Bool ℕ
three = inr Bool ℕ 3

okRight : Sum Bool ℕ
okRight = fold (λ (e : Bool) → inl Bool ℕ e) (λ (n : ℕ) → inr Bool ℕ (natAdd n 1)) three

okBind : Sum Bool ℕ
okBind = fold (λ (e : Bool) → inl Bool ℕ e) (λ (n : ℕ) → inl Bool ℕ false) three
